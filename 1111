### 5. MaterialsController (CRUD)

```csharp
[ApiController]
[Route("api/materials")]
[Authorize]
public class MaterialsController : ControllerBase
{
    private readonly AppDbContext _db;

    public MaterialsController(AppDbContext db) => _db = db;

    [HttpGet]
    public async Task<IActionResult> GetAll([FromQuery] int? topicId)
    {
        var query = _db.Materials.AsQueryable();
        if (topicId.HasValue)
            query = query.Where(m => m.TopicId == topicId);

        return Ok(await query.ToListAsync());
    }

    [HttpGet("{id}")]
    public async Task<IActionResult> Get(int id)
    {
        var material = await _db.Materials.FindAsync(id);
        return material == null ? NotFound() : Ok(material);
    }

    [HttpPost]
    [Authorize(Roles = "teacher")]
    public async Task<IActionResult> Create([FromBody] MaterialDto dto)
    {
        var material = new Material
        {
            TopicId = dto.TopicId,
            Title = dto.Title,
            Type = dto.Type,
            Content = dto.Content,
            FileUrl = dto.FileUrl
        };

        _db.Materials.Add(material);
        await _db.SaveChangesAsync();
        return CreatedAtAction(nameof(Get), new { id = material.Id }, material);
    }

    [HttpPut("{id}")]
    [Authorize(Roles = "teacher")]
    public async Task<IActionResult> Update(int id, [FromBody] MaterialDto dto)
    {
        var material = await _db.Materials.FindAsync(id);
        if (material == null) return NotFound();

        material.TopicId = dto.TopicId;
        material.Title = dto.Title;
        material.Type = dto.Type;
        material.Content = dto.Content;
        material.FileUrl = dto.FileUrl;

        await _db.SaveChangesAsync();
        return Ok(material);
    }

    [HttpDelete("{id}")]
    [Authorize(Roles = "teacher")]
    public async Task<IActionResult> Delete(int id)
    {
        var material = await _db.Materials.FindAsync(id);
        if (material == null) return NotFound();

        _db.Materials.Remove(material);
        await _db.SaveChangesAsync();
        return NoContent();
    }
}
