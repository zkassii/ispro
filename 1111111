### 6. Нужные эндпоинты на бэкенде (C#)

Добавь в `MaterialsController`:

```csharp
[HttpGet("{id}/progress")]
public async Task<IActionResult> GetProgress(int id)
{
    var userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);

    var progress = await _db.MaterialProgresses
        .FirstOrDefaultAsync(p => p.UserId == userId && p.MaterialId == id);

    if (progress == null)
        return Ok(new { materialId = id, isVisited = false, timeSpentSec = 0 });

    return Ok(new
    {
        materialId = progress.MaterialId,
        isVisited = progress.IsVisited,
        timeSpentSec = progress.TimeSpentSec,
        lastOpenedAt = progress.LastOpenedAt
    });
}

[HttpPost("{id}/progress")]
public async Task<IActionResult> UpdateProgress(int id, [FromBody] ProgressDto dto)
{
    var userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);

    var progress = await _db.MaterialProgresses
        .FirstOrDefaultAsync(p => p.UserId == userId && p.MaterialId == id);

    if (progress == null)
    {
        progress = new MaterialProgress
        {
            UserId = userId,
            MaterialId = id,
            IsVisited = true,
            TimeSpentSec = dto.TimeSpentSec,
            LastOpenedAt = DateTime.UtcNow
        };
        _db.MaterialProgresses.Add(progress);
    }
    else
    {
        progress.IsVisited = true;
        progress.TimeSpentSec += dto.TimeSpentSec;
        progress.LastOpenedAt = DateTime.UtcNow;
    }

    await _db.SaveChangesAsync();
    return Ok();
}

[HttpGet("/api/progress")]
public async Task<IActionResult> GetAllProgress()
{
    var userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    var list = await _db.MaterialProgresses
        .Where(p => p.UserId == userId)
        .ToListAsync();
    return Ok(list);
}
```

