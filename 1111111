### 5. Главный экран изучения (Study.razor) — самый важный

```razor
@page "/study/{Id:int}"
@inject ApiService Api
@implements IAsyncDisposable
@using System.Threading

<div class="study-layout">
    <div class="study-header d-flex justify-content-between align-items-center mb-3">
        <h3>@material?.Title</h3>
        <div class="timer badge bg-primary fs-6">
            Время: @FormatTime(timeSpent)
        </div>
    </div>

    @if (material == null)
    {
        <p>Загрузка материала...</p>
    }
    else
    {
        <div class="material-content card p-4 shadow-sm">
            @switch (material.Type.ToLower())
            {
                case "text":
                case "html":
                    <div>@((MarkupString)(material.Content ?? ""))</div>
                    break;

                case "pdf":
                    <iframe src="@material.FileUrl" width="100%" height="750px" style="border:none;"></iframe>
                    break;

                case "video":
                    <video src="@material.FileUrl" controls style="width:100%; max-height:700px;"></video>
                    break;

                default:
                    <a href="@material.FileUrl" target="_blank" class="btn btn-outline-primary">
                        Скачать файл (@material.Type)
                    </a>
                    break;
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Material? material;
    private int timeSpent;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        material = await Api.GetMaterialAsync(Id);

        // Отмечаем, что материал открыт
        await Api.UpdateProgressAsync(Id, 0);

        // Запускаем таймер
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        _ = RunTimerAsync(cts.Token);
    }

    private async Task RunTimerAsync(CancellationToken token)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(token))
            {
                timeSpent++;
                await InvokeAsync(StateHasChanged);

                // Каждые 30 секунд отправляем прогресс на сервер
                if (timeSpent % 30 == 0)
                {
                    await Api.UpdateProgressAsync(Id, 30);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private string FormatTime(int sec) =>
        $"{sec / 60:D2}:{sec % 60:D2}";

    public async ValueTask DisposeAsync()
    {
        cts?.Cancel();
        timer?.Dispose();
        cts?.Dispose();

        // При уходе со страницы отправляем оставшееся время
        if (timeSpent > 0)
        {
            await Api.UpdateProgressAsync(Id, timeSpent % 30);
        }
    }
}
```

