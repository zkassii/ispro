### 3. Работа с файлом + `using` / `finally` (п. 5.3)

```csharp
static void ProcessFile(string filename = "numbers.txt")
{
    StreamReader? reader = null;
    try
    {
        // Рекомендуемый способ — using
        using (reader = new StreamReader(filename))
        {
            var evenNumbers = new List<int>();
            string? line;
            while ((line = reader.ReadLine()) != null)
            {
                if (int.TryParse(line.Trim(), out int num) && num % 2 == 0)
                    evenNumbers.Add(num);
            }
            Console.WriteLine("Чётные числа: " + string.Join(", ", evenNumbers));
        }
    }
    catch (FileNotFoundException)
    {
        Console.WriteLine($"Файл '{filename}' не найден (FileNotFoundException)");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Ошибка: {ex.Message}");
    }
    finally
    {
        // Даже если using уже закрыл — проверяем
        if (reader != null && reader.BaseStream != null && reader.BaseStream.CanRead)
        {
            reader.Close();
            Console.WriteLine("Файл принудительно закрыт в finally");
        }
        else
        {
            Console.WriteLine("Файл уже закрыт (или не открывался)");
        }
    }
}
```

Альтернатива без `using` (только `finally`):
```csharp
static void ProcessFileFinally(string filename = "numbers.txt")
{
    StreamReader? reader = null;
    try
    {
        reader = new StreamReader(filename);
        // ... обработка
    }
    catch (FileNotFoundException)
    {
        Console.WriteLine("Файл не найден");
    }
    finally
    {
        reader?.Close();
        Console.WriteLine("Файл закрыт в finally");
    }
}
```

