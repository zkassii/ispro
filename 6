### 5. REST API на ASP.NET Core (п. 5.5)

**Создаём проект:**
```bash
dotnet new webapi -n Lab6Api
cd Lab6Api
dotnet add package NLog.Web.AspNetCore
```

**Program.cs (минимальный API):**
```csharp
using NLog.Web;

var builder = WebApplication.CreateBuilder(args);
builder.Logging.ClearProviders();
builder.Host.UseNLog();

var app = builder.Build();

var users = new Dictionary<int, object>
{
    [1] = new { id = 1, name = "Иван" },
    [2] = new { id = 2, name = "Мария" },
    [123] = new { id = 123, name = "Тестовый пользователь" }
};

app.MapGet("/user", (string? id, ILogger<Program> logger) =>
{
    if (string.IsNullOrEmpty(id))
    {
        return Results.Json(new { error = "Missing id parameter", statusCode = 400 }, statusCode: 400);
    }

    if (!int.TryParse(id, out int userId))
    {
        logger.LogError("Invalid ID format: {Id}", id);
        return Results.Json(new { error = "Invalid ID format", statusCode = 400 }, statusCode: 400);
    }

    if (!users.TryGetValue(userId, out var user))
    {
        logger.LogWarning("User not found: {Id}", userId);
        return Results.NotFound(new { error = "User not found", statusCode = 404 });
    }

    return Results.Ok(user);
});

// Глобальный обработчик необработанных исключений
app.UseExceptionHandler(errorApp =>
{
    errorApp.Run(async context =>
    {
        var logger = context.RequestServices.GetRequiredService<ILogger<Program>>();
        logger.LogError("Необработанное исключение в API");
        context.Response.StatusCode = 500;
        await context.Response.WriteAsJsonAsync(new { error = "Internal Server Error", statusCode = 500 });
    });
});

app.Run();
```

**nlog.config** (для API):
```xml
<?xml version="1.0" encoding="utf-8" ?>
<nlog>
  <targets>
    <target name="api" xsi:type="File" fileName="api_errors.log"
            layout="${longdate} | ${level} | ${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Error" writeTo="api" />
  </rules>
</nlog>
```

**Проверка:**
- `GET /user?id=123` → 200
- `GET /user?id=999` → 404
- `GET /user?id=abc` → 400 + JSON

