### 1. Консольное приложение + обработка исключений + NLog (п. 5.1)

**Проект:** Console App (.NET 8)

**Установка NLog:**
```bash
dotnet add package NLog
dotnet add package NLog.Extensions.Logging
```

**Файл `nlog.config`** (рядом с `.csproj`):
```xml
<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target name="errors" xsi:type="File" fileName="errors.log"
            layout="${longdate} | ${level} | ${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Error" writeTo="errors" />
  </rules>
</nlog>
```

**Program.cs:**
```csharp
using NLog;
using System;

class Program
{
    private static readonly Logger logger = LogManager.GetCurrentClassLogger();

    static void Main()
    {
        try
        {
            Console.Write("Введите первое число: ");
            double a = double.Parse(Console.ReadLine()!);

            Console.Write("Введите второе число: ");
            double b = double.Parse(Console.ReadLine()!);

            double result = a / b;
            Console.WriteLine($"Результат деления: {result}");
        }
        catch (FormatException)
        {
            string msg = "Ошибка формата: введено не число (FormatException)";
            Console.WriteLine(msg);
            logger.Error(msg);
        }
        catch (DivideByZeroException)
        {
            string msg = "Ошибка: деление на ноль (DivideByZeroException)";
            Console.WriteLine(msg);
            logger.Error(msg);
        }
        catch (Exception ex)
        {
            string msg = $"Общее исключение: {ex.Message}\n{ex.StackTrace}";
            Console.WriteLine(msg);
            logger.Error(ex, msg);
        }
    }
}
```

